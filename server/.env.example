# Server workspace env. Resolution order:
#   1. server/.env (auto-copied from this file by postinstall)
#   2. root .env (loaded by scripts and CI workflows)
#
# Don't commit .env. Commit changes to this template instead.

PORT=3001
HOST=0.0.0.0

# Neon Postgres connection string. Format:
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/tankpit?sslmode=require"
