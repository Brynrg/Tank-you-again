# Server workspace env.
#
# On `npm install` the postinstall script copies this file to server/.env if
# .env is missing, so `npm run db:push` and `npm run dev` work out of the box.
# .env is gitignored; commit changes here.

# Network port the Fastify+WS server binds to. Default in code: 3001.
PORT=3001

# Bind address. Default in code: 0.0.0.0.
HOST=0.0.0.0

# Prisma datasource URL. SQLite path is resolved relative to
# server/prisma/schema.prisma. To use Postgres locally:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/tank?schema=public"
# and update provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
