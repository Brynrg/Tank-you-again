# Tank You Again — root .env.example
#
# Copy to .env and fill in your values. .env is gitignored.
# All variables here are also documented in server/.env.example for the
# server workspace; this root file is what scripts/test-db-connection.ts reads.

# --- Database (Neon Postgres) -------------------------------------------------
# Free tier: https://console.neon.tech — create a project, copy the connection
# string under "Connection details". Looks like:
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/tankpit?sslmode=require"

# --- Server (Fastify + WebSocket) --------------------------------------------
# When deployed to Fly.io, these are set per-machine and the values here apply
# to local dev only.
PORT=3001
HOST=0.0.0.0
