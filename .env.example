# Tank You Again — root-level shared defaults.
#
# Copy to .env when you want overrides; everything below has safe code-level
# defaults so the stack runs without a .env at all.
#
# The server workspace also has its own server/.env.example with DB config.

# Network port the authoritative game server binds to.
PORT=3001

# Bind address. 0.0.0.0 makes the server reachable from LAN / Docker / Replit.
HOST=0.0.0.0

# Prisma datasource URL (override if you swap SQLite for Postgres).
# Path is resolved relative to server/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
